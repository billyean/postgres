SELECT test_planner_guc_hash() AS hash_before \gset
SET max_parallel_workers_per_gather = 0;
SELECT test_planner_guc_hash() <> :'hash_before'::int8 AS changed;
 changed 
---------
 t
(1 row)

RESET max_parallel_workers_per_gather;
