CREATE EXTENSION test_planner_guc_hash;
-- T1: Same settings produce same hash
SELECT test_planner_guc_hash() = test_planner_guc_hash() AS same_hash;
 same_hash 
-----------
 t
(1 row)

-- T2: Changing an enable_* flag changes the hash
SELECT test_planner_guc_hash() AS hash_before \gset
SET enable_seqscan = off;
SELECT test_planner_guc_hash() <> :'hash_before'::int8 AS changed;
 changed 
---------
 t
(1 row)

RESET enable_seqscan;
-- T3: Changing a cost constant changes the hash
SELECT test_planner_guc_hash() AS hash_before \gset
SET random_page_cost = 2.0;
SELECT test_planner_guc_hash() <> :'hash_before'::int8 AS changed;
 changed 
---------
 t
(1 row)

RESET random_page_cost;
